# Copy to .env and fill in. .env is git-ignored.

# Ollama Cloud (default provider, uses ChatOllama)
OLLAMA_API_KEY=
OLLAMA_MODEL=gpt-oss:120b
# For a local Ollama server instead, leave the key empty and set:
# OLLAMA_BASE_URL=http://localhost:11434

# How much the model thinks before each step: false (default, fastest), low, medium, high,
# or default (the model's own behaviour). gpt-oss can't turn thinking off; false means its lowest level.
# OLLAMA_THINK=false

# Optional
# MAX_STEPS=45
# SANDBOX_ADMIN_TOKEN=change-me      # protects /acme/admin (the sandbox world editor)
# LLM_PROVIDER=gemini                # use another provider instead, see README
